# SmartEmbedAgent — environment variables (all optional)
#
# Copy this file to `.env` and edit as needed. The agent will use these values
# if set; otherwise it falls back to the documented defaults.

# Local LLM model served by Ollama. Run `ollama pull <model>` first.
# Defaults to hermes3:8b (Nous Hermes 3, ~4.9 GB, strong tool calling).
# Other options: qwen3:8b, qwen3:30b-a3b, qwen3:4b
SMARTEMBED_LLM_MODEL=hermes3:8b

# Ollama server endpoint. Default is the local server started by `ollama serve`.
OLLAMA_BASE_URL=http://localhost:11434
